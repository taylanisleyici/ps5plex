# Real-Debrid API token — https://real-debrid.com/apitoken
RD_TOKEN=

# Plex claim token — https://plex.tv/claim  (EXPIRES IN 4 MINUTES)
# Only needed for the very first `docker compose up`. Blank it out afterwards.
PLEX_CLAIM=

# Your timezone, used by Plex for "recently added" etc.  e.g. Europe/Berlin
TZ=UTC

# This computer's LAN address. Plex inside Docker only knows its unreachable 172.x
# container IP, so it must be told what to advertise to the PS5.
# Find it with:  ipconfig getifaddr en0   (Linux: hostname -I)
PLEX_ADVERTISE_URL=http://192.168.1.10:32400

# --- watchlist robot ---
# Filled in automatically once the server is claimed: ./scripts/plex-token.sh
PLEX_TOKEN=

# Your Stremio scraper addon, WITHOUT the trailing /manifest.json.
# In Stremio: Addons -> (Comet / Torrentio / MediaFusion) -> copy the install URL.
# It already contains your Real-Debrid configuration.
#   e.g. https://comet.elfhosted.com/<your-config-id>
SCRAPER_URL=

# How often to check the watchlist, in seconds.
WATCHLIST_INTERVAL=120

# Source picker web UI (open this to choose torrents yourself).
PICKER_PORT=8099

# Leave at 0 to pick sources yourself. 1 lets it fetch automatically,
# at most MAX_PER_TITLE torrents per title.
AUTO_FETCH=0
MAX_PER_TITLE=3
