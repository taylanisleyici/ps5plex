# Real-Debrid API token — https://real-debrid.com/apitoken
RD_TOKEN=

# Plex claim token — https://plex.tv/claim  (EXPIRES IN 4 MINUTES)
# Only needed for the very first `docker compose up`. Blank it out afterwards.
PLEX_CLAIM=

# Your timezone, used by Plex for "recently added" etc.
TZ=Europe/Istanbul

# This Mac's LAN address. Plex inside Docker only knows its unreachable 172.x
# container IP, so it must be told what to advertise to the PS5.
# Find it with:  ipconfig getifaddr en0
PLEX_ADVERTISE_URL=http://192.168.3.20:32400

# --- Phase 2 (watchlist robot) fills these in later ---
PLEX_TOKEN=
TORRENTIO_URL=
